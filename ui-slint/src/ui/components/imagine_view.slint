import { ScrollView } from "std-widgets.slint";
import { Palette } from "../palette.slint";
import { Personas } from "../personas.slint";
import { ImagineJobItem, ImageItem, CutSegItem } from "../types.slint";

// ── ImagineView (🖼) — the Imaginarium studio window ─────────────────────────
//
// A thin native client for the node-local Imaginarium daemon (docs/imaginarium.md):
// prompt → POST /v1/images/generations → still preview, plus the node's shared
// jobs list (agent MCP jobs and these land in the same library). Rust owns all
// HTTP (IMAGINARIUM_URL/IMAGINARIUM_TOKEN); this view is controls + honest
// connection states. v1 is image-first — video jobs list and report their
// status, generation of them stays with the agent tools / browser studio.
// Lists live in ScrollViews (linuxkms drops the scroll wheel — the kiosk needs
// the scrollbar).

// A small selectable option chip (model / aspect / count rows).
component OptionChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;

    height: 24px;
    width: txt.preferred-width + 18px;
    border-radius: Palette.radius-sm;
    background: root.active ? Palette.primary-dim : (ta.has-hover ? Palette.surface-hi : Palette.surface);
    border-width: 1px;
    border-color: root.active ? Palette.primary : Palette.border;
    animate background, border-color { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    txt := Text {
        text: root.label;
        color: root.active ? Palette.primary : Palette.text-dim;
        font-size: 10px * Personas.font-scale;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A tiny square icon button (timeline row verbs).
component MiniBtn inherits Rectangle {
    in property <string> glyph;
    callback clicked;
    width: 18px;
    height: 18px;
    border-radius: Palette.radius-sm;
    background: mb-ta.has-hover ? Palette.surface-hi : transparent;
    mb-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.glyph;
        color: Palette.text-dim;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One Cutting Room timeline row: poster/glyph · label + detail · ▲ ▼ ✕.
component CutRow inherits Rectangle {
    in property <CutSegItem> seg;
    in property <bool> selected;
    callback pick;
    callback move-up;
    callback move-down;
    callback remove;

    height: 40px;
    border-radius: Palette.radius-sm;
    background: root.selected ? Palette.primary-dim
              : (cut-ta.has-hover ? Palette.surface-hi : Palette.surface);
    border-width: 1px;
    border-color: root.selected ? Palette.primary : Palette.border;
    animate background, border-color { duration: 120ms; }

    cut-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pick(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;
        spacing: 6px;

        if root.seg.has-thumb: Rectangle {
            width: 40px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: Palette.radius-sm;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.seg.thumb;
                image-fit: cover;
            }
        }
        if !root.seg.has-thumb: Text {
            width: 22px;
            text: root.seg.kind == 2 ? "▦" : (root.seg.kind == 1 ? "🖼" : "🎞");
            font-size: 13px;
            color: Palette.text-dim;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: (root.seg.caption != "" ? "💬 " : "") + root.seg.label;
                color: Palette.text-bright;
                font-size: 10px * Personas.font-scale;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.seg.detail;
                color: Palette.text-dim;
                font-size: 9px * Personas.font-scale;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 0px;
            MiniBtn { glyph: "▲"; clicked => { root.move-up(); } }
            MiniBtn { glyph: "▼"; clicked => { root.move-down(); } }
        }
        VerticalLayout {
            alignment: center;
            MiniBtn { glyph: "✕"; clicked => { root.remove(); } }
        }
    }
}

// One job row: status dot · mode glyph + model · timestamp; click = preview it.
component JobRow inherits Rectangle {
    in property <ImagineJobItem> job;
    in property <bool> selected;
    callback pick(string);

    height: row.preferred-height + 12px;
    border-radius: Palette.radius-sm;
    background: root.selected ? Palette.primary-dim
              : (ta.has-hover ? Palette.surface-hi : Palette.surface);
    border-width: 1px;
    border-color: root.selected ? Palette.primary : Palette.border;
    animate background, border-color { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pick(root.job.id); }
    }

    row := HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        // U3 poster (480px jpg, cached Rust-side) — the library picker's eye.
        if root.job.has-thumb: Rectangle {
            width: 44px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            border-radius: Palette.radius-sm;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.job.thumb;
                image-fit: cover;
            }
        }

        // Status dot — green done, amber in-flight, red failed/expired.
        Rectangle {
            y: 5px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.job.status == "done" ? #22c55e
                      : (root.job.status == "failed" || root.job.status == "expired"
                         || root.job.status == "cancelled") ? Palette.error
                      : Palette.warning;
        }

        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: (root.job.mode == "image_generate" || root.job.mode == "image_edit"
                       ? "🖼 " : "🎬 ") + root.job.model;
                color: Palette.text-bright;
                font-size: 11px * Personas.font-scale;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.job.status + " · " + root.job.when
                    + (root.job.err != "" ? " · " + root.job.err
                       : (root.job.prompt != "" ? " · " + root.job.prompt : ""));
                color: root.job.err != "" ? Palette.error : Palette.text-dim;
                font-size: 10px * Personas.font-scale;
                overflow: elide;
            }
        }
    }
}

export component ImagineView {
    preferred-height: 0px;
    min-height: 0px;

    // Connection: idle (never probed) | ok | auth (401) | offline.
    in property <string>           status: "idle";
    in property <string>           node-url: "";
    in property <bool>             busy: false;
    in property <string>           note: "";           // status line under the preview
    in property <string>           preview-kind: "none";  // none|image|video|error
    in property <image>            preview;
    in property <[ImagineJobItem]> jobs;
    in property <string>           selected-job: "";
    // Video player (A1): idle|ready|playing|ended — ready/playing/ended render
    // the preview image (poster / live frames) + the transport bar.
    in property <string>           video-state: "idle";
    in property <float>            video-progress: 0.0;
    in property <string>           video-time: "";
    property <bool> video-live: root.preview-kind == "video"
        && (root.video-state == "ready" || root.video-state == "playing" || root.video-state == "ended");

    in-out property <string>       prompt-input: "";
    // Generation mode + chain source (A2/A3): the ChainBar writes these, the
    // Rust submit clears the chain after a successful hand-off.
    in-out property <string>       gen-mode: "image";     // image | video
    in-out property <string>       chain-source: "";      // job id feeding I2V/extend
    in-out property <string>       chain-kind: "";        // image (→I2V) | video (→extend)
    // Local chip state — resets with the window, which is fine.
    property <int> model-ix: 0;    // 0 auto · 1 image (fast) · 2 quality
    property <int> aspect-ix: 0;   // index into aspect-labels
    property <int> n-ix: 0;        // 0 → 1 image · 1 → 2 · 2 → 4
    property <[string]> aspect-labels: ["1:1", "16:9", "9:16", "4:3", "3:4"];
    // Video chips (A2).
    property <int> vmodel-ix: 0;   // 0 auto · 1 video · 2 video-1.5
    property <int> vdur-ix: 2;     // index into vdur-secs (default 8s)
    property <int> vres-ix: 0;     // 0 auto · 1 480p · 2 720p · 3 1080p (I2V only)
    property <int> vaspect-ix: 0;  // 0 auto · then vaspect-labels[ix-1]
    property <[int]>    vdur-secs: [4, 6, 8, 10, 15];
    property <[string]> vaspect-labels: ["16:9", "9:16", "1:1"];
    // Cinematic pipeline (T2I2V): no source + toggle on → the node crafts a
    // quality still from the prompt first, then video-1.5 animates it at
    // 1080p — the path around v1.5 being I2V-only. Rides as source-kind
    // "cinematic" so the callback signature stays put.
    property <bool> cinema-on: false;
    // ~cost in cents: duration × 5¢/s (video) or 8¢/s (video-1.5);
    // cinematic adds the 5¢ quality still and always runs v1.5.
    property <string> video-cost: root.cinema-on && root.chain-source == ""
        ? "~" + (root.vdur-secs[root.vdur-ix] * 8 + 5) + "¢"
        : "~" + root.vdur-secs[root.vdur-ix] * (root.vmodel-ix == 2 ? 8 : 5) + "¢";

    // Prompt-from-file (any workspace text — agent notes, USB imports — is fuel).
    in property <[ImageItem]>      prompt-files;
    in-out property <bool>         prompt-picker-open: false;

    // ── The Cutting Room (A5) ───────────────────────────────────────────
    in property <[CutSegItem]>     cut-segments;
    in-out property <int>          cut-selected: -1;
    in property <string>           cut-total: "";
    in property <string>           cut-music-label: "";
    in-out property <int>          cut-letterbox-ix: 0;   // 0 off · 1 bars · 2 reveal
    in-out property <int>          cut-fades-ix: 1;       // 0 off · 1 soft · 2 film
    in-out property <bool>         cut-loudnorm: false;
    // The selected segment's projection (out-of-range → defaults, editor hides).
    property <bool> cut-has-sel: root.cut-selected >= 0 && root.cut-selected < root.cut-segments.length;
    property <CutSegItem> cur: root.cut-segments[max(0, root.cut-selected)];

    callback generate(string, string, string, int);  // prompt, model slug|"auto", aspect, n
    // prompt, model|"auto", duration s, res|"default", aspect|"default", source job id|"", source kind|""
    callback generate-video(string, string, int, string, string, string, string);
    callback pick-job(string);                       // job id → preview it
    callback refresh();
    callback video-play(int, int);                   // stage px w, h → decode at this size
    callback video-stop();
    callback prompt-files-refresh();                 // populate the picker list
    callback prompt-load(string);                    // workspace-relative path → prompt box
    callback cut-add(string);                        // done job id → clip/still/music by kind
    callback cut-remove(int);
    callback cut-move(int, int);                     // index, ±1
    callback cut-add-card();
    callback cut-set(string, string);                // editor verb → selected segment
    callback cut-music-clear();
    callback cut-render();

    function fire-generate() {
        if (root.gen-mode == "cut") {
            return;   // the prompt box is the caption composer here
        }
        if (root.gen-mode == "video") {
            root.fire-generate-video();
        } else if (root.prompt-input != "" && !root.busy && root.status == "ok") {
            root.generate(
                root.prompt-input,
                root.model-ix == 1 ? "image" : (root.model-ix == 2 ? "quality" : "auto"),
                root.aspect-labels[root.aspect-ix],
                root.n-ix == 1 ? 2 : (root.n-ix == 2 ? 4 : 1));
        }
    }

    function fire-generate-video() {
        // I2V may run promptless; T2V, extend, and cinematic require a prompt.
        if (!root.busy && root.status == "ok"
            && (root.prompt-input != "" || root.chain-kind == "image")) {
            root.generate-video(
                root.prompt-input,
                root.vmodel-ix == 1 ? "video" : (root.vmodel-ix == 2 ? "1.5" : "auto"),
                root.vdur-secs[root.vdur-ix],
                root.vres-ix == 1 ? "480p" : (root.vres-ix == 2 ? "720p" : (root.vres-ix == 3 ? "1080p" : "default")),
                root.vaspect-ix == 0 ? "default" : root.vaspect-labels[root.vaspect-ix - 1],
                root.chain-source,
                root.chain-kind != "" ? root.chain-kind
                    : (root.cinema-on ? "cinematic" : ""));
        }
    }

    VerticalLayout {
        // ── Header: connection dot · node URL · refresh ─────────────────
        Rectangle {
            height: 40px;
            background: Palette.surface;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 8px;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 9px;
                    height: 9px;
                    border-radius: 5px;
                    background: root.status == "ok" ? #22c55e
                              : (root.status == "auth" || root.status == "unconfigured") ? Palette.warning
                              : root.status == "offline" ? Palette.error
                              : Palette.text-dim;
                }
                Text {
                    text: "IMAGINE · " + (root.status == "ok" ? "CONNECTED"
                        : root.status == "auth" ? "TOKEN REJECTED"
                        : root.status == "unconfigured" ? "NO TOKEN"
                        : root.status == "offline" ? "NODE OFFLINE" : "…");
                    color: Palette.text-dim;
                    font-size: 9px * Personas.font-scale;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.node-url;
                    color: Palette.secondary;
                    font-size: 10px * Personas.font-scale;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 28px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Palette.radius-sm;
                    background: refresh-ta.has-hover ? Palette.surface-hi : transparent;
                    refresh-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.refresh(); }
                    }
                    Text {
                        text: "⟳";
                        color: Palette.text-dim;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Palette.border; }

        // ── Body: controls + jobs rail (left) · preview (right) ────────
        HorizontalLayout {
            vertical-stretch: 1;

            VerticalLayout {
                width: 280px;
                padding: 12px;
                spacing: 8px;

                // Mode: still image vs video (A2). Switching keeps the prompt.
                HorizontalLayout {
                    spacing: 6px;
                    OptionChip { label: "🖼 IMAGE"; active: root.gen-mode == "image"; clicked => { root.gen-mode = "image"; } }
                    OptionChip { label: "🎞 VIDEO"; active: root.gen-mode == "video"; clicked => { root.gen-mode = "video"; } }
                    OptionChip { label: "✂ CUT"; active: root.gen-mode == "cut"; clicked => { root.gen-mode = "cut"; } }
                }

                // Prompt — multi-line, Enter generates, Shift+Enter newline
                // (the composer idiom from input_bar.slint).
                Rectangle {
                    height: max(64px, min(field.preferred-height + 16px, 140px));
                    border-radius: Palette.radius;
                    background: Palette.surface;
                    border-width: 1px;
                    border-color: field.has-focus ? Palette.primary-dim : Palette.border;
                    clip: true;

                    field := TextInput {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        font-size: 12px * Personas.font-scale;
                        color: Palette.text;
                        single-line: false;
                        wrap: word-wrap;
                        enabled: !root.busy;
                        text <=> root.prompt-input;
                        key-pressed(e) => {
                            if (e.text == "\n" && !e.modifiers.shift) {
                                root.fire-generate();
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                    }
                    if field.text == "": Text {
                        x: 10px;
                        y: 8px;
                        text: root.gen-mode == "cut" ? "caption text — then SET CAPTION on a segment…"
                            : root.gen-mode == "video"
                            ? (root.chain-kind == "video" ? "describe the continuation…"
                               : root.chain-kind == "image" ? "how should it move? (optional)"
                               : "describe the video…")
                            : "describe the image…";
                        color: Palette.text-dim;
                        font-size: 12px * Personas.font-scale;
                    }
                }

                // Prompt from file: any workspace text (agent-written, USB-
                // carried, uploaded) feeds the box. Opens the picker below.
                HorizontalLayout {
                    alignment: end;
                    OptionChip {
                        label: "📄 FROM FILE";
                        active: false;
                        clicked => {
                            root.prompt-files-refresh();
                            root.prompt-picker-open = true;
                        }
                    }
                }

                // ── The Cutting Room (A5): timeline · editor · style · render ──
                if root.gen-mode == "cut": Text {
                    text: root.cut-total == "" ? "TIMELINE — click a done job below to add it"
                                               : "TIMELINE — " + root.cut-total;
                    color: Palette.text-dim;
                    font-size: 9px * Personas.font-scale;
                    letter-spacing: 1.5px;
                    height: 16px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.gen-mode == "cut": Rectangle {
                    height: min(128px, max(44px, root.cut-segments.length * 46px));
                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        VerticalLayout {
                            spacing: 4px;
                            alignment: start;
                            for seg[ix] in root.cut-segments: CutRow {
                                seg: seg;
                                selected: root.cut-selected == ix;
                                pick => { root.cut-selected = ix; }
                                move-up => { root.cut-move(ix, -1); }
                                move-down => { root.cut-move(ix, 1); }
                                remove => { root.cut-remove(ix); }
                            }
                            if root.cut-segments.length == 0: Text {
                                text: "empty reel — add finished jobs, or a card ▦";
                                color: Palette.text-dim;
                                font-size: 10px * Personas.font-scale;
                            }
                        }
                    }
                }

                if root.gen-mode == "cut": HorizontalLayout {
                    spacing: 6px;
                    OptionChip { label: "+ ▦ CARD"; active: false; clicked => { root.cut-add-card(); } }
                    // Music bed: set by clicking an audio job; cleared here.
                    Rectangle { horizontal-stretch: 1; }
                    if root.cut-music-label != "": OptionChip {
                        label: "🎵 " + root.cut-music-label + " ✕";
                        active: true;
                        clicked => { root.cut-music-clear(); }
                    }
                }

                // Segment editor — chips act on the selected row via cut-set.
                if root.gen-mode == "cut" && root.cut-has-sel && root.cur.kind == 0: HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "IN " + Math.round(root.cur.in-s * 10) / 10 + "s";
                        width: 58px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "−1";  active: false; clicked => { root.cut-set("in", "-1.0"); } }
                    OptionChip { label: "−½";  active: false; clicked => { root.cut-set("in", "-0.5"); } }
                    OptionChip { label: "+½";  active: false; clicked => { root.cut-set("in", "0.5"); } }
                    OptionChip { label: "+1";  active: false; clicked => { root.cut-set("in", "1.0"); } }
                }
                if root.gen-mode == "cut" && root.cut-has-sel && root.cur.kind == 0: HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: root.cur.out-s > root.cur.in-s
                            ? "OUT " + Math.round(root.cur.out-s * 10) / 10 + "s"
                            : "OUT end";
                        width: 58px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "−1";  active: false; clicked => { root.cut-set("out", "-1.0"); } }
                    OptionChip { label: "−½";  active: false; clicked => { root.cut-set("out", "-0.5"); } }
                    OptionChip { label: "+½";  active: false; clicked => { root.cut-set("out", "0.5"); } }
                    OptionChip { label: "+1";  active: false; clicked => { root.cut-set("out", "1.0"); } }
                }
                if root.gen-mode == "cut" && root.cut-has-sel && root.cur.kind == 0: HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "SPEED";
                        width: 58px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "½×";  active: root.cur.speed-ix == 0; clicked => { root.cut-set("speed", "0"); } }
                    OptionChip { label: "1×";  active: root.cur.speed-ix == 1; clicked => { root.cut-set("speed", "1"); } }
                    OptionChip { label: "1½×"; active: root.cur.speed-ix == 2; clicked => { root.cut-set("speed", "2"); } }
                    OptionChip { label: "2×";  active: root.cur.speed-ix == 3; clicked => { root.cut-set("speed", "3"); } }
                }
                if root.gen-mode == "cut" && root.cut-has-sel && root.cur.kind == 0: HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "GAIN";
                        width: 58px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "−12"; active: root.cur.gain-ix == 0; clicked => { root.cut-set("gain", "0"); } }
                    OptionChip { label: "−6";  active: root.cur.gain-ix == 1; clicked => { root.cut-set("gain", "1"); } }
                    OptionChip { label: "0dB"; active: root.cur.gain-ix == 2; clicked => { root.cut-set("gain", "2"); } }
                }
                if root.gen-mode == "cut" && root.cut-has-sel && root.cur.kind != 0: HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "DUR";
                        width: 58px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "2s"; active: root.cur.dur-ix == 0; clicked => { root.cut-set("dur", "0"); } }
                    OptionChip { label: "3s"; active: root.cur.dur-ix == 1; clicked => { root.cut-set("dur", "1"); } }
                    OptionChip { label: "4s"; active: root.cur.dur-ix == 2; clicked => { root.cut-set("dur", "2"); } }
                    OptionChip { label: "6s"; active: root.cur.dur-ix == 3; clicked => { root.cut-set("dur", "3"); } }
                }
                if root.gen-mode == "cut" && root.cut-has-sel && root.cur.kind == 1: HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "ZOOM";
                        width: 58px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "STATIC"; active: root.cur.zoom-ix == 0; clicked => { root.cut-set("zoom", "0"); } }
                    OptionChip { label: "PUSH";   active: root.cur.zoom-ix == 1; clicked => { root.cut-set("zoom", "1"); } }
                    OptionChip { label: "PUSH+";  active: root.cur.zoom-ix == 2; clicked => { root.cut-set("zoom", "2"); } }
                }
                if root.gen-mode == "cut" && root.cut-has-sel && root.cur.kind == 2: HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "BG";
                        width: 58px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    // Swatches mirror CUT_CARD_COLORS Rust-side.
                    for c[ix] in [#000000, #101418, #B7410E, #0E2A1C]: Rectangle {
                        width: 24px;
                        height: 20px;
                        border-radius: Palette.radius-sm;
                        background: c;
                        border-width: root.cur.color-ix == ix ? 2px : 1px;
                        border-color: root.cur.color-ix == ix ? Palette.primary : Palette.border;
                        sw-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.cut-set("color", ix); }
                        }
                    }
                }
                if root.gen-mode == "cut" && root.cut-has-sel: HorizontalLayout {
                    spacing: 4px;
                    OptionChip {
                        label: "💬 SET CAPTION";
                        active: root.cur.caption != "";
                        clicked => { root.cut-set("caption", root.prompt-input); }
                    }
                    if root.cur.caption != "": OptionChip {
                        label: "✕ CLEAR";
                        active: false;
                        clicked => { root.cut-set("caption-clear", ""); }
                    }
                }

                // Style: letterbox · fades · loudnorm (the U2b style block).
                if root.gen-mode == "cut": HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "LOOK";
                        width: 58px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "PLAIN";  active: root.cut-letterbox-ix == 0; clicked => { root.cut-letterbox-ix = 0; } }
                    OptionChip { label: "BARS";   active: root.cut-letterbox-ix == 1; clicked => { root.cut-letterbox-ix = 1; } }
                    OptionChip { label: "REVEAL"; active: root.cut-letterbox-ix == 2; clicked => { root.cut-letterbox-ix = 2; } }
                }
                if root.gen-mode == "cut": HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "FINISH";
                        width: 58px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "CUTS";   active: root.cut-fades-ix == 0; clicked => { root.cut-fades-ix = 0; } }
                    OptionChip { label: "SOFT";   active: root.cut-fades-ix == 1; clicked => { root.cut-fades-ix = 1; } }
                    OptionChip { label: "FILM";   active: root.cut-fades-ix == 2; clicked => { root.cut-fades-ix = 2; } }
                    OptionChip { label: "♪ NORM"; active: root.cut-loudnorm; clicked => { root.cut-loudnorm = !root.cut-loudnorm; } }
                }

                if root.gen-mode == "cut": Rectangle {
                    height: 36px;
                    border-radius: Palette.radius;
                    background: (root.busy || root.status != "ok" || root.cut-segments.length == 0)
                        ? Palette.surface
                        : (cutgo-ta.has-hover ? Palette.primary : Palette.primary-dim);
                    border-width: 1px;
                    border-color: (root.busy || root.status != "ok" || root.cut-segments.length == 0)
                        ? Palette.border : Palette.primary;
                    animate background { duration: 120ms; }
                    cutgo-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (!root.busy && root.status == "ok" && root.cut-segments.length > 0) {
                                root.cut-render();
                            }
                        }
                    }
                    Text {
                        text: root.busy ? "WORKING…" : "✂ RENDER THE CUT  (free · on-node)";
                        color: (root.busy || root.status != "ok" || root.cut-segments.length == 0)
                            ? Palette.text-dim : Palette.text-bright;
                        font-size: 11px * Personas.font-scale;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.gen-mode == "image": HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "MODEL";
                        width: 52px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "AUTO";    active: root.model-ix == 0; clicked => { root.model-ix = 0; } }
                    OptionChip { label: "FAST";    active: root.model-ix == 1; clicked => { root.model-ix = 1; } }
                    OptionChip { label: "QUALITY"; active: root.model-ix == 2; clicked => { root.model-ix = 2; } }
                }

                if root.gen-mode == "image": HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "RATIO";
                        width: 52px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                    for label[ix] in root.aspect-labels: OptionChip {
                        label: label;
                        active: root.aspect-ix == ix;
                        clicked => { root.aspect-ix = ix; }
                    }
                }

                if root.gen-mode == "image": HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "COUNT";
                        width: 52px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "1"; active: root.n-ix == 0; clicked => { root.n-ix = 0; } }
                    OptionChip { label: "2"; active: root.n-ix == 1; clicked => { root.n-ix = 1; } }
                    OptionChip { label: "4"; active: root.n-ix == 2; clicked => { root.n-ix = 2; } }
                }

                // ── Video controls (A2) ─────────────────────────────────
                if root.gen-mode == "video": HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "MODEL";
                        width: 52px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "AUTO"; active: root.vmodel-ix == 0; clicked => { root.vmodel-ix = 0; } }
                    OptionChip { label: "STD";  active: root.vmodel-ix == 1; clicked => { root.vmodel-ix = 1; } }
                    OptionChip { label: "V1.5"; active: root.vmodel-ix == 2; clicked => { root.vmodel-ix = 2; } }
                }

                if root.gen-mode == "video": HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.chain-kind == "video" ? "ADD s" : "LENGTH";
                        width: 52px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                    for secs[ix] in root.vdur-secs: OptionChip {
                        label: secs + "s";
                        active: root.vdur-ix == ix;
                        clicked => { root.vdur-ix = ix; }
                    }
                }

                if root.gen-mode == "video": HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "RES";
                        width: 52px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "AUTO"; active: root.vres-ix == 0; clicked => { root.vres-ix = 0; } }
                    OptionChip { label: "480p"; active: root.vres-ix == 1; clicked => { root.vres-ix = 1; } }
                    OptionChip { label: "720p"; active: root.vres-ix == 2; clicked => { root.vres-ix = 2; } }
                    // 1080p is video-1.5 = I2V-only upstream — offer it only
                    // when an image source is chained (mirrors the matrix).
                    if root.chain-kind == "image": OptionChip {
                        label: "1080p";
                        active: root.vres-ix == 3;
                        clicked => { root.vres-ix = 3; }
                    }
                }

                if root.gen-mode == "video": HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "RATIO";
                        width: 52px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                    OptionChip { label: "AUTO"; active: root.vaspect-ix == 0; clicked => { root.vaspect-ix = 0; } }
                    for label[ix] in root.vaspect-labels: OptionChip {
                        label: label;
                        active: root.vaspect-ix == ix + 1;
                        clicked => { root.vaspect-ix = ix + 1; }
                    }
                }

                // Cinematic pipeline toggle (T2I2V): only offered when nothing
                // is chained — a chained source already picks the modality.
                if root.gen-mode == "video" && root.chain-source == "": HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "PIPE";
                        width: 52px;
                        color: Palette.text-dim;
                        font-size: 9px * Personas.font-scale;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                    OptionChip {
                        label: "🎬 DIRECT";
                        active: !root.cinema-on;
                        clicked => { root.cinema-on = false; }
                    }
                    OptionChip {
                        label: "✨ CINEMA (still → 1080p)";
                        active: root.cinema-on;
                        clicked => { root.cinema-on = true; }
                    }
                }

                // Chain source chip: what this video continues from (A3).
                if root.gen-mode == "video" && root.chain-source != "": Rectangle {
                    height: 24px;
                    border-radius: Palette.radius-sm;
                    background: Palette.primary-dim;
                    border-width: 1px;
                    border-color: Palette.primary;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        spacing: 6px;
                        Text {
                            text: (root.chain-kind == "video" ? "⏩ continues " : "🔗 animates ")
                                + root.chain-source;
                            color: Palette.primary;
                            font-size: 10px * Personas.font-scale;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 18px;
                            background: clear-ta.has-hover ? Palette.surface-hi : transparent;
                            border-radius: Palette.radius-sm;
                            clear-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.chain-source = ""; root.chain-kind = ""; root.vres-ix = min(root.vres-ix, 2); }
                            }
                            Text {
                                text: "✕";
                                color: Palette.text-dim;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Generate — disabled while busy/offline; shows the rough spend.
                if root.gen-mode != "cut": Rectangle {
                    height: 36px;
                    border-radius: Palette.radius;
                    background: (root.busy || root.status != "ok"
                                 || (root.prompt-input == "" && !(root.gen-mode == "video" && root.chain-kind == "image")))
                        ? Palette.surface
                        : (gen-ta.has-hover ? Palette.primary : Palette.primary-dim);
                    border-width: 1px;
                    border-color: (root.busy || root.status != "ok") ? Palette.border : Palette.primary;
                    animate background { duration: 120ms; }
                    gen-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.fire-generate(); }
                    }
                    Text {
                        text: root.busy ? "WORKING…"
                            : root.gen-mode == "video"
                                ? (root.chain-kind == "video" ? "⏩ EXTEND  (" + root.video-cost + ")"
                                   : "🎞 GENERATE  (" + root.video-cost + ")")
                                : "✦ GENERATE  (~$" + (root.model-ix == 2 ? "0.05" : "0.02") + "/img)";
                        color: (root.busy || root.status != "ok"
                                || (root.prompt-input == "" && !(root.gen-mode == "video" && root.chain-kind == "image")))
                            ? Palette.text-dim : Palette.text-bright;
                        font-size: 11px * Personas.font-scale;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "JOBS ON THIS NODE";
                    color: Palette.text-dim;
                    font-size: 9px * Personas.font-scale;
                    letter-spacing: 1.5px;
                    height: 20px;
                    vertical-alignment: center;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;
                        for job in root.jobs: JobRow {
                            job: job;
                            selected: root.selected-job == job.id;
                            pick(id) => {
                                if (root.gen-mode == "cut") {
                                    root.cut-add(id);
                                } else {
                                    root.pick-job(id);
                                }
                            }
                        }
                        if root.jobs.length == 0: Text {
                            text: root.status == "ok" ? "no jobs yet — generate something ✦" : "";
                            color: Palette.text-dim;
                            font-size: 11px * Personas.font-scale;
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: Palette.border; }

            // ── Preview pane / the stage ────────────────────────────────
            stage := Rectangle {
                horizontal-stretch: 1;
                background: Palette.bg;

                if root.preview-kind == "image" || root.video-live: Image {
                    x: 14px;
                    y: 14px;
                    width: parent.width - 28px;
                    height: parent.height - (root.video-live ? 76px : 46px);
                    source: root.preview;
                    image-fit: contain;
                }
                if root.preview-kind != "image" && !root.video-live: VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: root.preview-kind == "video" ? "🎬"
                            : root.preview-kind == "error" ? "⚠" : "🖼";
                        font-size: 40px;
                        horizontal-alignment: center;
                        color: Palette.text-dim;
                    }
                    Text {
                        text: root.preview-kind == "video"
                                ? (root.video-state == "rendering"
                                   ? "🎞 rendering upstream — the rail tracks it; this pane comes alive when it lands"
                                   : "video job — no local preview (needs ffmpeg/ffprobe on this node)")
                            : root.preview-kind == "error" ? ""
                            : (root.status == "offline"
                                ? "imaginarium node unreachable — is imaginarium.service running?"
                            : root.status == "auth"
                                ? "the node rejected the token — /etc/imaginarium/env and /etc/agentd/env must carry the SAME IMAGINARIUM_TOKEN (restart both services after fixing)"
                            : root.status == "unconfigured"
                                ? "no token — agentd has no IMAGINARIUM_TOKEN yet. Provision with install.sh --imaginarium (docs/imaginarium.md), then hit ⟳"
                                : "generate an image, or pick a job from the list");
                        color: Palette.text-dim;
                        font-size: 12px * Personas.font-scale;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // ChainBar (A3): feed the selected result into the next verb.
                // Grows as targets ship — image→ANIMATE (I2V), video→EXTEND.
                if root.selected-job != "" && root.gen-mode != "cut"
                   && (root.preview-kind == "image" || root.video-live): Rectangle {
                    height: 26px;
                    width: chain-row.preferred-width + 16px;
                    x: parent.width - self.width - 14px;
                    y: 8px;
                    border-radius: Palette.radius-sm;
                    background: chain-ta.has-hover ? Palette.primary : Palette.primary-dim;
                    border-width: 1px;
                    border-color: Palette.primary;
                    animate background { duration: 120ms; }
                    chain-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.chain-source = root.selected-job;
                            root.chain-kind = root.preview-kind == "image" ? "image" : "video";
                            root.gen-mode = "video";
                            if (root.preview-kind != "image") {
                                // extend caps at +10s; 1080p is I2V-only
                                root.vres-ix = min(root.vres-ix, 2);
                                root.vdur-ix = min(root.vdur-ix, 3);
                            }
                        }
                    }
                    chain-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: root.preview-kind == "image" ? "✦ ANIMATE" : "⏩ EXTEND";
                            color: Palette.text-bright;
                            font-size: 10px * Personas.font-scale;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                // Transport bar (video only): ▶/⏹/↻ · progress · clock.
                if root.video-live: Rectangle {
                    x: 14px;
                    height: 26px;
                    width: parent.width - 28px;
                    y: parent.height - self.height - (root.note != "" ? 38px : 8px);
                    border-radius: Palette.radius-sm;
                    background: Palette.surface;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 10px;
                        spacing: 10px;

                        Rectangle {
                            width: 30px;
                            height: 22px;
                            y: (parent.height - self.height) / 2;
                            border-radius: Palette.radius-sm;
                            background: transport-ta.has-hover ? Palette.surface-hi : transparent;
                            transport-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (root.video-state == "playing") {
                                        root.video-stop();
                                    } else {
                                        root.video-play(
                                            Math.round(stage.width / 1px),
                                            Math.round((stage.height - 62px) / 1px));
                                    }
                                }
                            }
                            Text {
                                text: root.video-state == "playing" ? "⏹"
                                    : root.video-state == "ended" ? "↻" : "▶";
                                color: Palette.primary;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Progress track + fill.
                        Rectangle {
                            height: 4px;
                            y: (parent.height - self.height) / 2;
                            horizontal-stretch: 1;
                            border-radius: 2px;
                            background: Palette.surface-hi;
                            Rectangle {
                                x: 0;
                                width: parent.width * min(1.0, max(0.0, root.video-progress));
                                height: parent.height;
                                border-radius: 2px;
                                background: Palette.primary;
                            }
                        }

                        Text {
                            text: root.video-time;
                            color: Palette.text-dim;
                            font-size: 10px * Personas.font-scale;
                            vertical-alignment: center;
                        }
                    }
                }

                // Status line — cost / errors / "generating…" feedback.
                if root.note != "": Rectangle {
                    x: 14px;
                    height: 24px;
                    width: parent.width - 28px;
                    y: parent.height - self.height - 8px;
                    border-radius: Palette.radius-sm;
                    background: Palette.surface;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: root.note;
                        color: root.preview-kind == "error" ? Palette.error : Palette.text-dim;
                        font-size: 10px * Personas.font-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // ── Prompt-file picker overlay ──────────────────────────────────────
    if root.prompt-picker-open: Rectangle {
        background: #000000aa;
        dismiss-ta := TouchArea { clicked => { root.prompt-picker-open = false; } }

        Rectangle {
            width: min(parent.width - 48px, 420px);
            height: min(parent.height - 48px, 380px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Palette.radius;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.border-hi;
            TouchArea { }   // swallow clicks so the backdrop doesn't dismiss

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    Text {
                        text: "PROMPT FROM FILE";
                        color: Palette.text-dim;
                        font-size: 10px * Personas.font-scale;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 24px;
                        height: 22px;
                        border-radius: Palette.radius-sm;
                        background: close-ta.has-hover ? Palette.surface-hi : transparent;
                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.prompt-picker-open = false; }
                        }
                        Text {
                            text: "✕";
                            color: Palette.text-dim;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        for f in root.prompt-files: Rectangle {
                            height: 32px;
                            border-radius: Palette.radius-sm;
                            background: row-ta.has-hover ? Palette.surface-hi : transparent;
                            row-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.prompt-load(f.path);
                                    root.prompt-picker-open = false;
                                }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    text: "📄 " + f.name;
                                    color: Palette.text-bright;
                                    font-size: 12px * Personas.font-scale;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: f.path;
                                    color: Palette.text-dim;
                                    font-size: 10px * Personas.font-scale;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                        if root.prompt-files.length == 0: Text {
                            text: "no .txt / .md files in the workspace yet — ask APEX to write one, or drop one in via Files";
                            color: Palette.text-dim;
                            font-size: 11px * Personas.font-scale;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
