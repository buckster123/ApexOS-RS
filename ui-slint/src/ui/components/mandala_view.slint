// ── MandalaView (☸) — the Fabrica tree window ────────────────────────────────
// Renders the mandala trees as data: every cell's address, form, state, body
// (local worker or mesh peer), measures and barriers — the same reading
// `mandala_status` hands a conductor, mirrored to the human. Rows arrive
// PRE-BUILT from Rust (main.rs intercepts successful mandala_status tool
// results — the occipital follow-along idiom: shape-sniffed payload, never a
// tool name); this component only renders the flat depth-indented list (the
// house tree idiom — occipital reader blocks; kiosk scroll = ScrollView, no
// wheel on linuxkms).

import { Palette } from "../palette.slint";
import { Personas } from "../personas.slint";
import { MandalaRow } from "../types.slint";
import { ScrollView } from "std-widgets.slint";

export component MandalaView {
    preferred-height: 0px;
    min-height: 0px;

    in property <[MandalaRow]> rows;
    in property <string>       meta: "";        // "2 mandalas · 3 open cells" (or "")
    in property <int>          scroll-tick: 0;  // bump → scroll to top (fresh reading)

    changed scroll-tick => { sv.viewport-y = 0px; }

    function state-color(state: string) -> color {
        state == "open"      ? Palette.primary :
        state == "done"      ? Palette.text-dim :
        state == "failed"    ? Palette.error :
        state == "cancelled" ? Palette.text-dim :
        state == "closed"    ? Palette.text-dim :
        state == "orbit"     ? Palette.warning :
        state == "parked" || state == "blocked" ? Palette.warning :
        Palette.text;
    }

    VerticalLayout {
        // ── Header ──────────────────────────────────────────────────────
        Rectangle {
            height: 44px;
            background: Palette.surface;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 14px;
                spacing: 8px;
                Text {
                    text: "FABRICA · MANDALA TREES";
                    color: Palette.text-dim;
                    font-size: 9px * Personas.font-scale;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.meta;
                    color: Palette.text-dim;
                    font-size: 10px * Personas.font-scale;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 1px; background: Palette.border; }

        // ── The trees, flattened (depth = indent) ───────────────────────
        sv := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;
                spacing: 2px;
                alignment: start;

                if root.rows.length == 0: Text {
                    text: "No mandala reading yet — this window mirrors the agent's mandala_status.\nAsk for one (\"show me the mandalas\") and the trees appear here.";
                    color: Palette.text-dim;
                    font-size: 11px * Personas.font-scale;
                    wrap: word-wrap;
                }

                for row in root.rows: Rectangle {
                    height: row.kind == "mandala" ? 30px : 22px;
                    background: row.kind == "mandala" ? Palette.surface : transparent;
                    border-radius: row.kind == "mandala" ? 6px : 0px;
                    HorizontalLayout {
                        padding-left: 10px + row.depth * 18px;
                        padding-right: 10px;
                        spacing: 6px;
                        Text {
                            text: row.text;
                            color: row.kind == "note" ? Palette.text-dim : state-color(row.state);
                            font-size: (row.kind == "mandala" ? 12px : 11px) * Personas.font-scale;
                            font-weight: row.kind == "mandala" || row.kind == "gate" ? 700 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
