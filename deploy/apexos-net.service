[Unit]
Description=ApexOS tools worker (net)
Documentation=file:///usr/local/share/doc/apexos/gotchas.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apexos-net
Group=apexos-workspace
WorkingDirectory=/var/lib/agentd/workspace
UMask=0007
# Common knobs + optional notify keys. Never EnvironmentFile=/etc/agentd/env.
EnvironmentFile=-/etc/agentd/tools.env
EnvironmentFile=-/etc/agentd/tools-net.env
Environment=APEXOS_TOOLS_CLASS=net
ExecStart=/usr/local/bin/apexos-tools --class net --listen /run/apexos/tools-net.sock
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/agentd/workspace /run/apexos
ReadOnlyPaths=/var/lib/agentd/events
InaccessiblePaths=-/etc/agentd/env -/etc/agentd/ui.env -/etc/agentd/apexnet.psk -/etc/imaginarium -/etc/sonus

[Install]
WantedBy=multi-user.target
