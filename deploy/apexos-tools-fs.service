[Unit]
Description=ApexOS tools worker (fs/shell)
Documentation=file:///usr/local/share/doc/apexos/gotchas.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apexos-tools
Group=apexos-workspace
WorkingDirectory=/var/lib/agentd/workspace
UMask=0007
# Non-secret knobs only. Never EnvironmentFile=/etc/agentd/env.
EnvironmentFile=-/etc/agentd/tools.env
Environment=APEXOS_TOOLS_CLASS=fs
Environment=APEXOS_NETNS=0
ExecStart=/usr/local/bin/apexos-tools --class fs --listen /run/apexos/tools-fs.sock
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
# Do not add RestrictNamespaces / SystemCallArchitectures / ProtectProc=pid:
# on systemd 257 + Pi 6.12 those filters return ENOSYS for openat2 (os error 38)
# and hide /proc/uptime. PrivateDevices similarly. Field: apex1 2026-08-17.
ReadWritePaths=/var/lib/agentd/workspace /var/lib/agentd/usb-eject /var/lib/agentd/usb-prep /var/lib/agentd/notifications.jsonl /run/apexos
ReadOnlyPaths=/var/lib/agentd/events /etc/agentd/parts /proc/uptime /proc/meminfo /proc/loadavg /proc/cpuinfo /proc/mounts
InaccessiblePaths=-/etc/agentd/env -/etc/agentd/ui.env -/etc/agentd/apexnet.psk -/etc/imaginarium -/etc/sonus

[Install]
WantedBy=multi-user.target
