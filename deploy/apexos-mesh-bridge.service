[Unit]
Description=ApexOS mesh-bridge (ApexNET radio UART)
Documentation=file:///usr/local/share/doc/apexos/gotchas.md
After=agentd.service
Wants=agentd.service

[Service]
Type=simple
User=agentd
Group=agentd
SupplementaryGroups=dialout
EnvironmentFile=-/etc/agentd/env
Environment=AGENTD_MESH_WS=ws://127.0.0.1:8787/mesh-bridge
ExecStart=/usr/local/bin/apexos-mesh-bridge
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# UART: do not PrivateDevices. Do not DevicePolicy=closed + DeviceAllow=/dev/ttyACM*
# — systemd treats that glob as a literal path, so ttyACM0 is EPERM while
# `sudo -u agentd` succeeds. dialout DAC is the access control
# (field: apex1/apex2 2026-08-17).

[Install]
WantedBy=multi-user.target
